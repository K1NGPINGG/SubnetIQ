# ==================================================
# GG_IPAM Production Environment Variables
# ==================================================
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# Application
APP_NAME=SubnetIQ
APP_VERSION=1.0.3
DEBUG=false
SECRET_KEY=change-me-to-a-random-secret-key

# ==================================================
# Deployment / Reverse Proxy
# ==================================================

# Standalone app port - where the SPA + API is served directly on the host.
# Point an existing reverse proxy (NPM, Traefik, Caddy) at http://localhost:APP_PORT.
APP_PORT=3000

# Bundled Nginx (start with: docker compose --profile with-proxy up -d)
# Upstream app service that the bundled Nginx proxies to.
APP_SERVICE=subnetiq-app
APP_SERVICE_PORT=80

# Public domain / server name for the bundled Nginx.
APP_DOMAIN=localhost

# SSL handling for the bundled Nginx:
#   selfsigned  - auto-generate a self-signed cert on boot (default, Mode A)
#   letsencrypt - obtain/renew a Let's Encrypt cert via HTTP-01 (Mode B)
#   custom      - use certs you place in ./certs/custom/ (Mode C)
SSL_MODE=selfsigned

# Required when SSL_MODE=letsencrypt.
LETSENCRYPT_EMAIL=

# CORS - restrict to known origins
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database
POSTGRES_DB=ipam_db
POSTGRES_USER=ipam_user
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://ipam_user:change-me@postgres:5432/ipam_db
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT
JWT_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Credential Encryption (Fernet - generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=change-me

# Superadmin (CHANGE after first login)
SUPERADMIN_EMAIL=admin@ipam.local
SUPERADMIN_PASSWORD=change-me

# Azure AD (optional)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# LDAP (optional)
LDAP_SERVER=ldap://localhost:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_BASE=ou=users,dc=example,dc=com
